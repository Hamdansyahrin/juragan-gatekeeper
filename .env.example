# JURAGAN-1 Proof Gatekeeper agent — copy to .env and fill in. NEVER commit .env.

# Platform-generated HMAC secret: dashboard -> My Agents -> Rotate Secret.
# The plaintext is shown ONCE. A placeholder/mismatched value fails preflight.
AGENT_GAMES_HMAC_SECRET=

# Kurier (zkVerify) mainnet API key — free signup at https://kurier.xyz
# Optional: without it the agent still decides + returns its Groth16 proof;
# only the on-chain finalization / proof_tx pointer is skipped.
KURIER_API_KEY=

# Server
PORT=8787
HOST=127.0.0.1

# How the string task_id (e.g. "gk_24_9d1") is converted to a field element
# for our decision proof. NOT documented by the platform — calibrate in
# practice. One of: keccak | sha256 | numeric
TASK_ID_MODE=keccak

# Response signing format for x-agent-games-signature: hex | base64
SIGNATURE_FORMAT=hex

# Budgets (ms). Hard platform deadline is 60000.
RESPONSE_BUDGET_MS=55000
KURIER_WAIT_MS=40000
